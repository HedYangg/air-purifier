      <mxCell id="27" value="Pull-down holds the control low at reset." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#405970;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="824" y="422" width="350" height="25" as="geometry" /></mxCell>
      <mxCell id="28" value="" style="rounded=1;arcSize=12;fillColor=#FFF6E6;strokeColor=#E8C17D;" vertex="1" parent="1"><mxGeometry x="42" y="506" width="1236" height="63" as="geometry" /></mxCell>
      <mxCell id="29" value="For a 5 V-only input, insert a 74AHCT125 non-inverting buffer between GPIO17 and S. Keep the pull-down at its input, tie OE low, and use the 5 V sensor supply and node ground. Confirm the exact module and idle state first." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#5B4027;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="61" y="512" width="1197" height="51" as="geometry" /></mxCell>
      <mxCell id="30" value="" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C9D9E5;" vertex="1" parent="1"><mxGeometry x="42" y="589" width="1236" height="252" as="geometry" /></mxCell>
      <mxCell id="31" value="Motor contacts · low-voltage DC only" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#15435C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="600" width="1191" height="29" as="geometry" /></mxCell>
      <mxCell id="32" value="Use a separate supply rated for the fan. Check the relay module's DC contact rating against fan inrush." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#405970;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="64" y="631" width="1191" height="24" as="geometry" /></mxCell>
      <mxCell id="33" value="Motor supply +" style="rounded=1;arcSize=16;html=0;fillColor=#E8F2F8;strokeColor=#B9CBD8;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#12263B;spacing=7;" vertex="1" parent="1"><mxGeometry x="78" y="666" width="175" height="52" as="geometry" /></mxCell>
      <mxCell id="34" value="Fuse" style="rounded=1;arcSize=16;html=0;fillColor=#E8F2F8;strokeColor=#B9CBD8;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#12263B;spacing=7;" vertex="1" parent="1"><mxGeometry x="314" y="666" width="144" height="52" as="geometry" /></mxCell>
      <mxCell id="35" value="KY-019 COM → NO
Leave NC open" style="rounded=1;arcSize=16;html=0;fillColor=#FFF1D9;strokeColor=#B9CBD8;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#12263B;spacing=7;" vertex="1" parent="1"><mxGeometry x="524" y="666" width="255" height="52" as="geometry" /></mxCell>
