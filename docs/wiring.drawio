      <mxCell id="6" value="Signal circuitry and motor current use separate power paths. Keep the relay contacts open at idle." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#D1E4EC;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="1220" height="20" as="geometry" /></mxCell>
