      <mxCell id="37" value="Motor supply −" style="rounded=1;arcSize=16;html=0;fillColor=#E8F2F8;strokeColor=#B9CBD8;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#12263B;spacing=7;" vertex="1" parent="1"><mxGeometry x="1077" y="766" width="165" height="43" as="geometry" /></mxCell>
      <mxCell id="38" style="strokeWidth=3;strokeColor=#B54F23;endArrow=block;dashed=0;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="253" y="692" as="sourcePoint" /><mxPoint x="314" y="692" as="targetPoint" /></mxGeometry></mxCell>
      <mxCell id="39" style="strokeWidth=3;strokeColor=#B54F23;endArrow=block;dashed=0;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="458" y="692" as="sourcePoint" /><mxPoint x="524" y="692" as="targetPoint" /></mxGeometry></mxCell>
      <mxCell id="40" style="strokeWidth=3;strokeColor=#B54F23;endArrow=block;dashed=0;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="779" y="692" as="sourcePoint" /><mxPoint x="848" y="692" as="targetPoint" /></mxGeometry></mxCell>
      <mxCell id="41" style="strokeWidth=3;strokeColor=#374151;endArrow=none;dashed=0;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1028" y="692" as="sourcePoint" /><mxPoint x="1159" y="766" as="targetPoint" /><Array as="points"><mxPoint x="1080" y="692" /><mxPoint x="1080" y="743" /><mxPoint x="1159" y="743" /></Array></mxGeometry></mxCell>
      <mxCell id="42" value="Fan negative return" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#374151;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1000" y="723" width="231" height="22" as="geometry" /></mxCell>
      <mxCell id="43" value="For a brushed DC motor, add a suitably rated flyback diode across the motor (stripe to +). For a brushless fan, follow its manufacturer's transient protection guidance." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#405970;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="75" y="757" width="932" height="49" as="geometry" /></mxCell>
      <mxCell id="44" value="Verify COM / NO with a meter, then test the relay at boot and during tip-over with the motor supply disconnected." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#405970;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="44" y="907" width="1234" height="26" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
